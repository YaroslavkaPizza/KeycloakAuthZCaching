<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>KeycloakAuthZ.Caching</PackageId>
		<Version>0.1.0</Version>
		<Authors>Aleshin Yaroslav</Authors>
		<Description>Services for easy permission caching setup with IDistributedCache</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<OutputType>Library</OutputType>
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<DebugSymbols>true</DebugSymbols>
		<CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
		<CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.*-*" />
		<PackageReference Include="Duende.AccessTokenManagement" Version="4.0.1" />
		<PackageReference Include="Duende.AccessTokenManagement.OpenIdConnect" Version="4.0.1" />
		<PackageReference Include="Keycloak.AuthServices.Authentication" Version="2.7.0" />
		<PackageReference Include="Keycloak.AuthServices.Authorization" Version="2.7.0" />
		<PackageReference Include="StackExchange.Redis" Version="2.9.*" />
		<PackageReference Include="StackExchange.Redis.Extensions.AspNetCore" Version="8.0.0-*"/>
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0-*"/>
	</ItemGroup>
</Project>
